{
  "name": "dreamcast-devtools",
  "private": true,
  "version": "3.0.0-pre",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --tsconfig tsconfig.server.json server/mockServer.ts",
    "mock:serve": "tsx --tsconfig tsconfig.server.json server/mockServer.ts",
    "mock:dev": "npm run build:dspsim && tsx --tsconfig tsconfig.server.json server/mockServer.ts",
    "mock:prod": "npm run build:native && cross-env NODE_ENV=production tsx --tsconfig tsconfig.server.json server/mockServer.ts",
    "build": "npm run build:native",
    "build:native": "tsc -b && vite build --outDir dist-native",
    "build:wasm": "tsc -b && cross-env VITE_TRANSPORT_MODE=wasm vite build --outDir dist-wasm",
    "build:dspsim": "tsx --tsconfig tsconfig.scripts.json scripts/build-dspsim.ts",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "contract": "tsx --tsconfig tsconfig.scripts.json scripts/contract-test.ts",
    "check": "npm run lint && npm run typecheck && npm run test:run && npm run contract -- --milestone M2 --require-note \"arm7: bl stepped over and out\" && npm run contract -- --milestone M2 --mock-support m2 --require-note \"arm7: bl stepped over and out\" && npm run build:native && npm run build:wasm"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@monaco-editor/react": "^4.6.0",
    "@mui/icons-material": "^7.3.4",
    "@mui/lab": "^7.0.1-beta.18",
    "@mui/material": "^7.3.4",
    "@mui/x-data-grid": "^8.13.1",
    "@mui/x-tree-view": "^8.13.1",
    "dockview": "^4.9.0",
    "immer": "^10.1.3",
    "monaco-editor": "^0.52.0",
    "pako": "^2.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.3",
    "zod": "^4.1.12",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@playwright/test": "1.63.0",
    "@types/express": "^5.0.3",
    "@types/node": "^24.6.0",
    "@types/pako": "^2.0.4",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/ui": "^3.2.4",
    "cross-env": "^10.1.0",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "express": "^5.1.0",
    "globals": "^16.4.0",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.45.0",
    "vite": "^7.1.7",
    "vitest": "^3.2.4",
    "ws": "^8.18.3"
  }
}
